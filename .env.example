# Copy to .env and fill in. Never commit .env.

# Root folder of the smok-studio tracks (read-only). Example:
SMOK_STUDIO_DIR=/Users/airbook/Studio/Smokrates

# TikTok developer app (docs/tiktok-setup.md). Redirect URI must match the app registration exactly.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8723/callback/
# Sandbox pair (used instead of the pair above when both are set; works before app review)
TIKTOK_CLIENT_KEY_SANDBOX=
TIKTOK_CLIENT_SECRET_SANDBOX=
# Browser app for the TikTok sign-in (the one logged in to the creator account)
TIKTOK_AUTH_BROWSER=Safari
# Instagram long-lived user token (docs/meta-setup.md). .instagram/token.json wins when it exists.
INSTAGRAM_ACCESS_TOKEN=
# YouTube upload: OAuth Desktop client (consent screen in Testing). An API key cannot upload.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Oracle box address for scripts/deploy-site.sh and npm run instagram:draft (video staging) (required, no default)
VPS_HOST=
