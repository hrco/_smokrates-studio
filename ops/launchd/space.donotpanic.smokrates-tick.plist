<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>space.donotpanic.smokrates-tick</string>
	<key>UserName</key>
	<string>airbook</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/curl</string>
		<string>-fsS</string>
		<string>--max-time</string>
		<string>600</string>
		<string>-X</string>
		<string>POST</string>
		<string>-H</string>
		<string>Origin: http://127.0.0.1:8724</string>
		<string>http://127.0.0.1:8724/api/tick</string>
	</array>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>StandardOutPath</key>
	<string>/Users/airbook/Library/Logs/smokrates-tick.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/airbook/Library/Logs/smokrates-tick.log</string>
</dict>
</plist>
